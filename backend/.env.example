# ============================================================
#  Configuración del backend (api + workers)
#  Copia este archivo como ".env" y completa tus datos.
# ============================================================

# --- Cuenta de Gmail -----------------------------------------
# Correo de Gmail que envía y recibe los mensajes
GMAIL_USER=tu_correo@gmail.com
# Contraseña de APLICACIÓN de 16 caracteres (NO tu contraseña normal)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Nombre que verá el destinatario como remitente
REMITENTE_NOMBRE=Mensajería RabbitMQ

# --- SMTP (envío) --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- IMAP (recepción) ----------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Máximo de correos nuevos (llegados después de iniciar los workers) por revisión (cada 30 s)
IMAP_MAX_POR_CICLO=20

# --- RabbitMQ ------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- API -----------------------------------------------------
API_PORT=3001
# Origen permitido por CORS (el frontend de Next.js)
FRONTEND_URL=http://localhost:3000

# --- Base de datos SQLite (compartida por api y workers) -----
DB_PATH=./data/correos.sqlite
